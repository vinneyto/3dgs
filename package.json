{
  "name": "3dgs-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @3dgs/examples",
    "build": "npm run build -w @3dgs/examples && rm -rf .next && cp -R packages/examples/.next .next",
    "lint": "npm run lint -w @3dgs/examples",
    "start": "npm run start -w @3dgs/examples",
    "wasm:build": "npm run wasm:build -w @3dgs/examples",
    "wasm:watch": "npm run wasm:watch -w @3dgs/examples"
  }
}
